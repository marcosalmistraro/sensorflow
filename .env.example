# Copy this file to .env and fill in any values you want to override.
# All fields are optional — the defaults in src/config.py are production-safe.

# ── Paths ──────────────────────────────────────────────────────────────────────
DATA_DIR=data/raw
MODELS_DIR=models
REPORTS_DIR=reports

# ── SMAP dataset ───────────────────────────────────────────────────────────────
SMAP_TRAIN_URL=https://s3-us-west-2.amazonaws.com/telemanom/data/train.pkl
SMAP_TEST_URL=https://s3-us-west-2.amazonaws.com/telemanom/data/test.pkl
SMAP_LABELS_URL=https://raw.githubusercontent.com/khundman/telemanom/master/labeled_anomalies.csv
SMAP_N_CHANNELS=54

# ── Feature engineering ────────────────────────────────────────────────────────
WINDOW_SIZE=64
STEP_SIZE=1
N_LAG_FEATURES=5
TEST_SPLIT_RATIO=0.2
RANDOM_SEED=42

# ── Isolation Forest ───────────────────────────────────────────────────────────
IF_N_ESTIMATORS=200
IF_CONTAMINATION=0.05
IF_MAX_SAMPLES=auto

# ── LSTM Autoencoder ───────────────────────────────────────────────────────────
LSTM_HIDDEN_SIZE=64
LSTM_NUM_LAYERS=2
LSTM_EPOCHS=30
LSTM_BATCH_SIZE=256
LSTM_LEARNING_RATE=0.001
LSTM_PATIENCE=5
LSTM_RECONSTRUCTION_THRESHOLD_PERCENTILE=95.0

# ── MLflow ─────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sensorflow-anomaly-detection
MLFLOW_MODEL_NAME=sensorflow-anomaly-detector
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_CHALLENGER_ALIAS=challenger

# ── FastAPI ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=SensorFlow Anomaly Detection API
API_VERSION=0.1.0
API_WORKERS=1

# ── Drift monitoring ───────────────────────────────────────────────────────────
DRIFT_THRESHOLD=0.5
DRIFT_P_VALUE=0.05
